# =============================================================================
# MVP Runtime — copy to `config/.env` and fill in your values
#   copy config\.env.example config\.env
# Do not commit `config/.env` if it contains real API keys.
# =============================================================================

# --- YOLO (Ultralytics) — Step 1 detection ------------------------------------
# Weights live under project `weights/` (see scripts/download_yolo_weights.py).
# YOLO-World (*world*.pt): open-vocab; classes come from template ObjectTarget.
YOLO_MODEL_PATH=weights/yolov8s-worldv2.pt

# Optional: extra comma-separated prompts for YOLO-World set_classes
# YOLO_WORLD_EXTRA_CLASSES=
# YOLO_WORLD_MAX_CLASSES=12

# Detection confidence threshold (0.0–1.0)
YOLO_CONF_THRESHOLD=0.25

# Device: cpu | cuda | 0 | 1 ...
YOLO_DEVICE=cpu

# Set to 1 to force mock boxes (ignore YOLO_MODEL_PATH)
MVP_FORCE_YOLO_MOCK=0

# --- Gemini (Google AI / VLM) — verification & attributes --------------------
# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model id, e.g. gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# Optional: custom API base URL (proxy / Vertex compatibility layer)
GEMINI_API_BASE=

# Request timeout in seconds
GEMINI_TIMEOUT_SEC=120

# Set to 1 to keep mock Gemini responses (no HTTP calls) even if API key is set
MVP_FORCE_GEMINI_MOCK=1

# --- Planner (strategy layer) ----------------------------------------------------
# Set to 1 to force static plan (skip Gemini Planner)
MVP_DISABLE_PLANNER=1

# Model used for planning strategy (gemini-2.0-flash or gemini-2.5-pro)
PLANNER_MODEL=gemini-2.0-flash

# --- Alternative model paths -----------------------------------------------------
# Smaller/faster YOLO-World v2 variant (~70MB)
YOLO_MODEL_PATH_S=weights/yolov8s-worldv2.pt

# Gemini Pro model ID (higher quality, slower)
GEMINI_MODEL_PRO=gemini-2.5-pro

# --- HTTP test script (temp/test_run_annotation.py) ----------------------------
MVP_BASE_URL=http://127.0.0.1:8000
# MVP_IMAGE_PATH=
# MVP_TEMPLATE_PATH=
